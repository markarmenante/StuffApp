{
  "manifest_version": 3,
  "name": "StuffApp eBay Reader",
  "version": "1.0.0",
  "description": "Read your exact eBay order in this browser when you request Check or import in StuffApp.",
  "minimum_chrome_version": "110",
  "key": "",
  "permissions": [
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://www.ebay.com/*",
    "https://order.ebay.com/*",
    "https://signin.ebay.com/*"
  ],
  "externally_connectable": {
    "matches": [
      "https://stuff.armenante.com/*"
    ]
  },
  "background": {
    "service_worker": "background.mjs",
    "type": "module"
  }
}
